<table>
    <tr>
        <th>ስም</th>
        <th>ስልክ</th>
        <th>ቲኬት ቁጥር</th>
        <th>ደረሰኝ ፎቶ</th>
        <th>ሁኔታ</th>
    </tr>
    <% tickets.forEach(t => { %>
        <tr>
            <td><%= t.name %></td>
            <td><%= t.phone %></td>
            <td><%= t.ticketNumber %></td>
            <td>
                <% if(t.receiptImage) { %>
                    <a href="/uploads/<%= t.receiptImage %>" target="_blank">ፎቶውን እይ</a>
                <% } else { %> ፎቶ የለም <% } %>
            </td>
            <td><%= t.status %></td>
        </tr>
    <% }) %>
</table>
