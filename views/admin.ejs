<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <title>የአድሚን ገጽ</title>
    <style>
        table { width: 100%; border-collapse: collapse; font-family: sans-serif; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        th { background: #f4f4f4; }
        .win-btn { background: #ffD700; border: none; padding: 8px 12px; cursor: pointer; border-radius: 5px; font-weight: bold; }
        .win-btn:hover { background: #ffc107; }
        .winner-label { color: #28a745; font-weight: bold; }
    </style>
</head>
<body>
    <h2>የተመዘገቡ ተሳታፊዎች ዝርዝር</h2>
    <table>
        <tr>
            <th>ስም</th>
            <th>ስልክ</th>
            <th>አይነት</th>
            <th>ቁጥር</th>
            <th>ደረሰኝ</th>
            <th>ሁኔታ</th>
            <th>እርምጃ</th>
        </tr>
        <% tickets.forEach(t => { %>
            <tr>
                <td><%= t.name %></td>
                <td><%= t.phone %></td>
                <td><%= t.prizeType %></td>
                <td><%= t.ticketNumber %></td>
                <td>
                    <% if(t.receiptImage) { %>
                        <a href="/uploads/<%= t.receiptImage %>" target="_blank">እይ</a>
                    <% } %>
                </td>
                <td><%= t.status %></td>
                <td>
                    <% if (t.status !== 'Winner') { %>
                        <form action="/make-winner/<%= t._id %>" method="POST">
                            <button type="submit" class="win-btn">🏆 አሸናፊ አድርግ</button>
                        </form>
                    <% } else { %>
                        <span class="winner-label">✅ አሸናፊ ሆኗል</span>
                    <% } %>
                </td>
            </tr>
        <% }) %>
    </table>
</body>
</html>
