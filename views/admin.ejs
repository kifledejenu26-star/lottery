<!DOCTYPE html>
<html>
<head><title>Admin</title><style>table{width:100%; border-collapse:collapse;} td,th{border:1px solid #ddd; padding:10px;}</style></head>
<body>
    <h2>የተመዘገቡ ሰዎች ዝርዝር</h2>
    <table>
        <tr><th>ስም</th><th>ስልክ</th><th>ደረሰኝ ቁጥር</th><th>ሁኔታ</th></tr>
        <% tickets.forEach(t => { %>
            <tr><td><%= t.name %></td><td><%= t.phone %></td><td><%= t.transactionId %></td><td><%= t.status %></td></tr>
        <% }) %>
    </table>
</body>
</html>
