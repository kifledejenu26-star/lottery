<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <title>የአድሚን ገጽ</title>
    <style>
        body { font-family: sans-serif; background: #f4f4f4; padding: 20px; }
        table { width: 100%; border-collapse: collapse; background: white; }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        th { background: #007bff; color: white; }
        .draw-btn { background: #28a745; color: white; padding: 15px 25px; text-decoration: none; border-radius: 8px; font-weight: bold; display: block; width: fit-content; margin: 20px auto; }
        .win-btn { background: #ffD700; color: #333; text-decoration: none; padding: 5px 10px; border-radius: 4px; font-weight: bold; }
        .winner-label { color: #28a745; font-weight: bold; }
    </style>
</head>
<body>
    <h2 style="text-align: center;">የተሳታፊዎች ዝርዝር</h2>

    <!-- አውቶማቲክ ዕጣ ማውጫ ቁልፍ -->
    <a href="/pick-random-winner" class="draw-btn" onclick="return confirm('ሲስተሙ በዘፈቀደ ዕጣ እንዲያወጣ ትፈልጋለህ?')">
        🎲 በዘፈቀደ ዕጣ አውጣ
    </a>

    <table>
        <tr>
            <th>ስም</th>
            <th>ስልክ</th>
            <th>አይነት</th>
            <th>ቲኬት ቁጥር</th>
            <th>ሁኔታ</th>
            <th>እርምጃ</th>
        </tr>
        <% tickets.forEach(t => { %>
            <tr>
                <td><%= t.name %></td>
                <td><%= t.phone %></td>
                <td><%= t.prizeType %></td>
                <td>#<%= t.ticketNumber %></td>
                <td><%= t.status %></td>
                <td>
                    <% if (t.status !== 'Winner') { %>
                        <a href="/make-winner/<%= t._id %>" class="win-btn">🏆 መርጠህ አሸንፍ</a>
                    <% } else { %>
                        <span class="winner-label">✅ አሸናፊ ሆኗል</span>
                    <% } %>
                </td>
            </tr>
        <% }) %>
    </table>
</body>
</html>
