<form action="/confirm-payment" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="ticketId" value="<%= ticketId %>">
    <input type="text" name="transactionId" placeholder="የደረሰኝ ቁጥር" required>
    
    <label>የደረሰኝ ፎቶ ይጫኑ፦</label>
    <input type="file" name="receiptImage" accept="image/*" required>
    
    <button type="submit" class="submit-btn">ክፍያውን አረጋግጥ</button>
</form>
