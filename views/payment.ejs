<div class="payment-card" style="font-family: sans-serif; border: 1px solid #ddd; border-radius: 10px; padding: 20px; max-width: 450px; margin: auto;">
    <h2 style="background: #2e7d32; color: white; padding: 10px; margin: -20px -20px 20px -20px; border-radius: 10px 10px 0 0;">Payment Information</h2>
    
    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding: 10px 0;">
        <span>Total Payment</span>
        <strong><%= price %> ETB</strong>
    </div>
    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding: 10px 0;">
        <span>Ticket Number</span>
        <strong><%= ticketNumber %></strong>
    </div>

    <div style="margin-top: 20px;">
        <!-- የቴሌብር በተን -->
        <div style="background: #2196f3; color: white; padding: 15px; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; margin-bottom: 10px;">
            <span>Pay using</span>
            <img src="/images/telebirr-logo.png" alt="Telebirr" style="height: 30px; margin-left: 10px;">
        </div>

        <!-- የሲቤ ብር በተን -->
        <div style="background: #9c27b0; color: white; padding: 15px; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer;">
            <span>Pay using</span>
            <img src="/images/cbebirr-logo.png" alt="CBEBirr" style="height: 30px; margin-left: 10px;">
        </div>
    </div>
</div>
