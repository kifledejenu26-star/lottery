<!DOCTYPE html>
<html>
<body style="text-align:center; font-family:sans-serif;">
    <h1>የዕለቱ አሸናፊ</h1>
    <% if(winner) { %>
        <div style="font-size: 24px; color: gold; background: #1a1a1a; padding: 20px; display: inline-block; border-radius: 10px;">
            እንኳን ደስ አለህ <strong><%= winner.name %></strong>! <br>
            የሎተሪ ቁጥርህ፦ <%= winner.ticketNumber %>
        </div>
    <% } else { %>
        <p>ገና አሸናፊ አልተመረጠም</p>
    <% } %>
</body>
</html>
